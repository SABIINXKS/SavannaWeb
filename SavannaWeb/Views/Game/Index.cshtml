@{
    ViewData["Title"] = "Game Page";
    var saves = ViewBag.Saves as List<SavannaWeb.Models.GameSave>;
}

<h2>Welcome to the Game!</h2>

<form method="post" asp-action="SaveGame" id="saveGameForm">
    <textarea name="saveData" id="saveData" rows="5" cols="50" placeholder="Enter game data here (JSON or text)"></textarea><br />
    <button type="submit">💾 Save Game</button>
</form>

@if (saves != null && saves.Any())
{
    <h3>Your Saved Games</h3>
    <ul id="saveList">
        @foreach (var save in saves)
        {
            <li data-save="@save.SaveData">
                <strong>@save.SavedAt.ToString("g")</strong><br />
                <span class="gameInfo">Loading game data...</span><br />
                <form method="get" asp-action="LoadGame" asp-route-id="@save.Id" style="display:inline">
                    <button type="submit">▶ Load</button>
                </form>
            </li>
        }
    </ul>
}
else
{
    <p>No saved games yet.</p>
}

@if (ViewBag.LoadedGame != null)
{
    <h3>Loaded Game Data</h3>
    <pre>@ViewBag.LoadedGame</pre>
}

@section Scripts {
    <script>
        let isSaved = true;

        const textarea = document.getElementById('saveData');
        const form = document.getElementById('saveGameForm');

        textarea.addEventListener('input', () => {
            isSaved = false;
        });

        form.addEventListener('submit', () => {
            isSaved = true;
        });

        window.addEventListener('beforeunload', function (e) {
            if (!isSaved) {
                const confirmationMessage = 'You have unsaved progress. Are you sure you want to leave? Your changes will be lost.';
                e.returnValue = confirmationMessage;
                return confirmationMessage;
            }
        });

        // Animal code/name to icon mapping
        const animalIcons = {
            "Lion": "🦁",
            "Zebra": "🦓",
            "Elephant": "🐘",
            "Giraffe": "🦒",
            "A": "🦁",      // Example: "A" for Lion
            "Z": "🦓",      // Example: "Z" for Zebra
            "E": "🐘",      // Example: "E" for Elephant
            "G": "🦒"       // Example: "G" for Giraffe
            // Add more as needed
        };

        // Display iteration, living animals count, and animal icons for each saved game
        document.querySelectorAll('#saveList li').forEach(li => {
            const rawData = li.dataset.save;

            try {
                const decoded = JSON.parse(rawData);
                const iteration = decoded.iteration ?? 'N/A';
                const animals = decoded.livingAnimals ?? 'N/A';

                // Try to get animal list/array from save data
                let animalList = decoded.animals ?? decoded.animalList ?? [];
                if (!Array.isArray(animalList)) animalList = [];

                // Map animal codes/names to icons
                const animalIconsStr = animalList.map(a => animalIcons[a] || a).join(' ');

                const info = `🌀 Iteration: ${iteration} | 🐾 Animals Alive: ${animals}` +
                    (animalIconsStr ? `<br>Animals: ${animalIconsStr}` : '');

                li.querySelector('.gameInfo').innerHTML = info;
            } catch (e) {
                li.querySelector('.gameInfo').textContent = '⚠️ Invalid game data';
            }
        });
    </script>
}
